# Copie para .env e ajuste.

# "desenvolvimento" ou "producao". Em produção o cookie de sessão exige HTTPS
# e a SECRET_KEY padrão é recusada.
AMBIENTE=desenvolvimento

# SQLite para desenvolvimento local. Em produção use PostgreSQL, ex.:
# DATABASE_URL=postgresql://usuario:senha@host:5432/glicemia
DATABASE_URL=sqlite:///./glicemia.db

# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

# Duração da sessão em minutos (padrão: 7 dias).
TOKEN_EXPIRA_MINUTOS=10080

# Fuso usado nas exportações.
FUSO_HORARIO=America/Sao_Paulo
